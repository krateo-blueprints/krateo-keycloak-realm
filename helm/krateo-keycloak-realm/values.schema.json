{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "krateo-keycloak-realm values",
  "type": "object",
  "properties": {
    "global": {
      "description": "Injected by Krateo's chart-inspector at install time.",
      "type": "object"
    },
    "resourceGroup": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "realm": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][-A-Za-z0-9_.]*$"
        },
        "displayName": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "registrationAllowed": {
          "type": "boolean"
        },
        "resetPasswordAllowed": {
          "type": "boolean"
        },
        "verifyEmail": {
          "type": "boolean"
        },
        "loginWithEmailAllowed": {
          "type": "boolean"
        },
        "actionTokenGeneratedByAdminLifespan": {
          "description": "Seconds an administrator-sent action link (the set-password email) stays valid.",
          "type": "integer",
          "minimum": 60
        },
        "rememberMe": {
          "description": "Show \"Remember me\" on the sign-in page. A ticked session gets a persistent cookie and rememberMeSessions' timeouts; unticked sessions are unchanged. Default false (Keycloak's default).",
          "type": "boolean"
        },
        "rememberMeSessions": {
          "description": "SSO timeouts (seconds) for sessions signed in with Remember me ticked. 0 = use the realm's ordinary SSO timeouts.",
          "type": "object",
          "properties": {
            "idleTimeout": {
              "type": "integer",
              "minimum": 0
            },
            "maxLifespan": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "events": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "expiration": {
              "description": "Seconds Keycloak keeps user and admin events.",
              "type": "integer",
              "minimum": 1
            },
            "types": {
              "description": "Keycloak EventType names (checked in CI against the pinned list).",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "listeners": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "adminEvents": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "includeRepresentation": {
              "type": "boolean"
            }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "string",
              "pattern": "^[0-9]{1,5}$"
            },
            "from": {
              "type": "string"
            },
            "fromDisplayName": {
              "type": "string"
            },
            "replyTo": {
              "type": "string"
            },
            "auth": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "starttls": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "ssl": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "credentialsSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "userKey": {
                  "type": "string",
                  "minLength": 1
                },
                "passwordKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecretKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "authType": {
              "type": "string",
              "enum": [
                "basic",
                "token"
              ]
            },
            "token": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "clientId": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          }
        },
        "offlineSessions": {
          "type": "object",
          "title": "Offline sessions",
          "additionalProperties": false,
          "description": "Offline sessions (offline_access refresh tokens, e.g. personal agents).",
          "properties": {
            "maxLifespan": {
              "type": "integer",
              "minimum": 0,
              "title": "Max lifespan",
              "default": 2592000,
              "description": "Maximum lifetime of an offline session from its creation, in seconds. 0 = no maximum (Keycloak's default). Realm-wide."
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "description": "Keycloak group attributes: each key maps to a list of strings.",
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "userProfile": {
      "type": "object",
      "description": "The realm's whole declarative user profile: Keycloak's default (username, email, firstName, lastName) followed by these attributes. Undeclared attributes stay disabled.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Not username, email, firstName or lastName: those come from Keycloak's default profile (the chart fails on a redeclaration)."
              },
              "displayName": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "multivalued": {
                "type": "boolean"
              },
              "validations": {
                "type": "object",
                "description": "Validators keyed by id, e.g. length: {max: 36}: exactly those the keycloak-config-kog KeycloakUserProfile CRD declares (it prunes any other silently).",
                "additionalProperties": false,
                "properties": {
                  "length": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer"
                      },
                      "max": {
                        "type": "integer"
                      },
                      "trim-disabled": {
                        "type": "boolean"
                      },
                      "error-message": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "email": {
                    "type": "object",
                    "properties": {
                      "max-local-length": {
                        "type": "integer"
                      },
                      "error-message": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "pattern": {
                    "type": "object",
                    "properties": {
                      "pattern": {
                        "type": "string"
                      },
                      "error-message": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "uri": {
                    "type": "object",
                    "properties": {
                      "error-message": {
                        "type": "string",
                        "description": "Message (or message key) shown when the validation fails."
                      }
                    },
                    "additionalProperties": false
                  },
                  "integer": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer"
                      },
                      "max": {
                        "type": "integer"
                      }
                    },
                    "additionalProperties": false
                  },
                  "double": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "description": "Whole numbers only: keycloak-config-kog's CRD types it integer."
                      },
                      "max": {
                        "type": "integer",
                        "description": "Whole numbers only: keycloak-config-kog's CRD types it integer."
                      }
                    },
                    "additionalProperties": false
                  },
                  "local-date": {
                    "type": "object",
                    "properties": {
                      "error-message": {
                        "type": "string",
                        "description": "Message (or message key) shown when the validation fails."
                      }
                    },
                    "additionalProperties": false
                  },
                  "iso-date": {
                    "type": "object",
                    "properties": {
                      "error-message": {
                        "type": "string",
                        "description": "Message (or message key) shown when the validation fails."
                      }
                    },
                    "additionalProperties": false
                  },
                  "multivalued": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer"
                      },
                      "max": {
                        "type": "integer"
                      }
                    },
                    "additionalProperties": false
                  },
                  "username-prohibited-characters": {
                    "type": "object",
                    "properties": {
                      "error-message": {
                        "type": "string",
                        "description": "Message (or message key) shown when the validation fails."
                      }
                    },
                    "additionalProperties": false
                  },
                  "up-username-not-idn-homograph": {
                    "type": "object",
                    "properties": {
                      "error-message": {
                        "type": "string",
                        "description": "Message (or message key) shown when the validation fails."
                      }
                    },
                    "additionalProperties": false
                  },
                  "person-name-prohibited-characters": {
                    "type": "object",
                    "properties": {
                      "error-message": {
                        "type": "string",
                        "description": "Message (or message key) shown when the validation fails."
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "required": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "user"
                      ]
                    }
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "permissions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "view": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "user"
                      ]
                    }
                  },
                  "edit": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "user"
                      ]
                    }
                  }
                }
              },
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "clients": {
      "type": "array",
      "description": "Confidential relying parties (e.g. Keystone), one KeycloakClient each, with a generated client secret.",
      "items": {
        "type": "object",
        "required": [
          "clientId",
          "redirectUris"
        ],
        "additionalProperties": false,
        "properties": {
          "clientId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "redirectUris": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "webOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postLogoutRedirectUris": {
            "type": "string"
          },
          "groupsClaim": {
            "type": "string"
          },
          "backchannelLogout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "sessionRequired": {
                "type": "boolean"
              }
            }
          },
          "secret": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "length": {
                "type": "integer",
                "minimum": 32
              }
            }
          }
        }
      }
    },
    "identityLifecycle": {
      "type": "object",
      "title": "identity-lifecycle client",
      "description": "identity-lifecycle's own client for access requests: confidential, service account only, secret generated once into a Secret it mounts, and its service account holding exactly `roles` of `roleClientId` (keycloak-config-kog >= 0.8.0).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "description": "Render the client, its secret and the role mapping.",
          "default": false
        },
        "clientId": {
          "type": "string",
          "title": "Client ID",
          "description": "The client's clientId (identity-lifecycle's accessRequest.keycloak.clientId).",
          "default": "identity-lifecycle"
        },
        "secret": {
          "type": "object",
          "title": "Client secret",
          "description": "The Secret the client secret is generated into, in the release namespace (identity-lifecycle's accessRequest.keycloak.clientSecretRef).",
          "properties": {
            "name": {
              "type": "string",
              "title": "Secret name",
              "description": "Name of the generated Secret.",
              "default": "identity-lifecycle-idp"
            },
            "key": {
              "type": "string",
              "title": "Secret key",
              "description": "Key of the client secret in it.",
              "default": "clientSecret"
            }
          }
        },
        "roleClientId": {
          "type": "string",
          "title": "Role client",
          "description": "clientId of the client that owns the roles.",
          "default": "realm-management"
        },
        "roles": {
          "type": "array",
          "title": "Roles",
          "description": "Exactly the roles of roleClientId the service account holds; a role added by hand is removed.",
          "items": {
            "type": "string"
          },
          "default": [
            "manage-users",
            "view-users",
            "query-groups"
          ]
        }
      }
    },
    "ideClient": {
      "type": "object",
      "title": "IDE client",
      "description": "The public client IDEs (Claude Code, Cursor) sign in with to reach the platform's MCP endpoint: authorization code + PKCE S256, loopback redirects, preferred_username, the portal's groups claim, and `audience` in the access token's aud (keycloak-config-kog >= 0.9.1 with oasgen-provider >= 0.67.0).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "description": "Render the IDE client.",
          "default": false
        },
        "clientId": {
          "type": "string",
          "title": "Client ID",
          "description": "The IDE's --client-id and the MCP gateway's clientId.",
          "default": "krateo-ide"
        },
        "name": {
          "type": "string",
          "title": "Display name",
          "description": "Shown on the consent and login pages.",
          "default": "Krateo IDE (MCP)"
        },
        "redirectUris": {
          "type": "array",
          "title": "Redirect URIs",
          "description": "Loopback redirects; the IDE opens the port (RFC 8252 7.3).",
          "items": {
            "type": "string"
          },
          "default": [
            "http://localhost:*",
            "http://127.0.0.1:*"
          ]
        }
      }
    },
    "parentClient": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "rootUrl": {
          "type": "string"
        },
        "redirectUris": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Required when enabled: the portal frontend's OIDC callback page (not an authn URL), e.g. https://cmp.example.com/auth?kind=oidc with host-based exposure. With path-based exposure it must not fall under another component's path prefix (e.g. authn's /auth)."
        },
        "webOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postLogoutRedirectUris": {
          "type": "string"
        },
        "groupsClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deletionPolicy": {
      "description": "orphan (default): deleting this chart's resources leaves the Keycloak objects in place. delete: deletes them.",
      "type": "string",
      "enum": [
        "orphan",
        "delete"
      ]
    },
    "oidcConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "keycloakUrl": {
          "type": "string",
          "pattern": "^(https://.+)?$"
        },
        "discoveryUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalScopes": {
          "type": "string"
        },
        "graphics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "displayName": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "backgroundColor": {
              "type": "string"
            },
            "textColor": {
              "type": "string"
            }
          }
        }
      }
    },
    "users": {
      "type": "array",
      "description": "Realm users this chart owns. No credentials: a user sets the first password via \"Forgot password?\".",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9._@-]+$",
            "description": "Length bounds mirror the realm user profile's username validation (files/keycloak-26-default-user-profile.json: min 3, max 255); Keycloak refuses a shorter username with a 400 at create, so the chart refuses it at render."
          },
          "firstName": {
            "type": "string",
            "maxLength": 255
          },
          "lastName": {
            "type": "string",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "description": "KeycloakUser object name; set it to adopt an existing CR in place. Default <realm>-<username>.",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "title": "MCP resource",
      "description": "The MCP resource every MCP client's access token names, and the claims authn reads.",
      "properties": {
        "audience": {
          "type": "string",
          "title": "Audience",
          "description": "The MCP resource in the access token's aud, e.g. https://cmp.example.com/mcp. Required when ideClient, hermesClient or agentRegistration is enabled.",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "hermesClient": {
      "type": "object",
      "title": "Hermes client",
      "description": "Hermes Agent, pre-registered public client (PKCE S256), redirect http://127.0.0.1/callback.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": false
        },
        "clientId": {
          "type": "string",
          "title": "Client ID",
          "default": "hermes"
        },
        "name": {
          "type": "string",
          "title": "Name",
          "default": "Hermes Agent (MCP)"
        }
      },
      "additionalProperties": false
    },
    "agentRegistration": {
      "type": "object",
      "title": "Agent registration",
      "description": "Anonymous dynamic client registration for personal agents: clients start disabled, loopback-only redirects, mcp scope only.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": false
        },
        "maxClients": {
          "type": "integer",
          "title": "Max clients",
          "description": "Keycloak's Max Clients Limit policy.",
          "minimum": 1,
          "default": 200
        }
      },
      "additionalProperties": false
    }
  }
}
