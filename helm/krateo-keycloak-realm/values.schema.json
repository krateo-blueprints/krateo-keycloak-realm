{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "krateo-keycloak-realm values",
  "type": "object",
  "properties": {
    "global": {
      "description": "Injected by Krateo's chart-inspector at install time.",
      "type": "object"
    },
    "resourceGroup": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "realm": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][-A-Za-z0-9_.]*$"
        },
        "displayName": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "registrationAllowed": {
          "type": "boolean"
        },
        "resetPasswordAllowed": {
          "type": "boolean"
        },
        "verifyEmail": {
          "type": "boolean"
        },
        "loginWithEmailAllowed": {
          "type": "boolean"
        },
        "actionTokenGeneratedByAdminLifespan": {
          "description": "Seconds an administrator-sent action link (the set-password email) stays valid.",
          "type": "integer",
          "minimum": 60
        },
        "events": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "expiration": {
              "description": "Seconds Keycloak keeps user and admin events.",
              "type": "integer",
              "minimum": 1
            },
            "types": {
              "description": "Keycloak EventType names (checked in CI against the pinned list).",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "listeners": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "adminEvents": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "includeRepresentation": {
              "type": "boolean"
            }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "string",
              "pattern": "^[0-9]{1,5}$"
            },
            "from": {
              "type": "string"
            },
            "fromDisplayName": {
              "type": "string"
            },
            "replyTo": {
              "type": "string"
            },
            "auth": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "starttls": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "ssl": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "credentialsSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "userKey": {
                  "type": "string",
                  "minLength": 1
                },
                "passwordKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecretKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "authType": {
              "type": "string",
              "enum": [
                "basic",
                "token"
              ]
            },
            "token": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "clientId": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "description": "Keycloak group attributes: each key maps to a list of strings.",
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "userProfile": {
      "type": "object",
      "description": "The realm's whole declarative user profile: Keycloak's default (username, email, firstName, lastName) followed by these attributes. Undeclared attributes stay disabled.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Not username, email, firstName or lastName: those come from Keycloak's default profile (the chart fails on a redeclaration)."
              },
              "displayName": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "multivalued": {
                "type": "boolean"
              },
              "validations": {
                "description": "Validators keyed by id, e.g. length: {max: 36}; the KOG's KeycloakUserProfile CRD validates their shape.",
                "type": "object"
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "required": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "user"
                      ]
                    }
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "permissions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "view": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "user"
                      ]
                    }
                  },
                  "edit": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "admin",
                        "user"
                      ]
                    }
                  }
                }
              },
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "clients": {
      "type": "array",
      "description": "Confidential relying parties (e.g. Keystone), one KeycloakClient each, with a generated client secret.",
      "items": {
        "type": "object",
        "required": [
          "clientId",
          "redirectUris"
        ],
        "additionalProperties": false,
        "properties": {
          "clientId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "redirectUris": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "webOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postLogoutRedirectUris": {
            "type": "string"
          },
          "groupsClaim": {
            "type": "string"
          },
          "backchannelLogout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "sessionRequired": {
                "type": "boolean"
              }
            }
          },
          "secret": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "length": {
                "type": "integer",
                "minimum": 32
              }
            }
          }
        }
      }
    },
    "identityLifecycle": {
      "type": "object",
      "title": "identity-lifecycle client",
      "description": "identity-lifecycle's own client for access requests: confidential, service account only, secret generated once into a Secret it mounts, and its service account holding exactly `roles` of `roleClientId` (keycloak-config-kog >= 0.8.0).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "description": "Render the client, its secret and the role mapping.",
          "default": false
        },
        "clientId": {
          "type": "string",
          "title": "Client ID",
          "description": "The client's clientId (identity-lifecycle's accessRequest.keycloak.clientId).",
          "default": "identity-lifecycle"
        },
        "secret": {
          "type": "object",
          "title": "Client secret",
          "description": "The Secret the client secret is generated into, in the release namespace (identity-lifecycle's accessRequest.keycloak.clientSecretRef).",
          "properties": {
            "name": {
              "type": "string",
              "title": "Secret name",
              "description": "Name of the generated Secret.",
              "default": "identity-lifecycle-idp"
            },
            "key": {
              "type": "string",
              "title": "Secret key",
              "description": "Key of the client secret in it.",
              "default": "clientSecret"
            }
          }
        },
        "roleClientId": {
          "type": "string",
          "title": "Role client",
          "description": "clientId of the client that owns the roles.",
          "default": "realm-management"
        },
        "roles": {
          "type": "array",
          "title": "Roles",
          "description": "Exactly the roles of roleClientId the service account holds; a role added by hand is removed.",
          "items": {
            "type": "string"
          },
          "default": [
            "manage-users",
            "view-users",
            "query-groups"
          ]
        }
      }
    },
    "ideClient": {
      "type": "object",
      "title": "IDE client",
      "description": "The public client IDEs (Claude Code, Cursor) sign in with to reach the platform's MCP endpoint: authorization code + PKCE S256, loopback redirects, preferred_username, the portal's groups claim, and `audience` in the access token's aud.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "description": "Render the IDE client.",
          "default": false
        },
        "clientId": {
          "type": "string",
          "title": "Client ID",
          "description": "The IDE's --client-id and the MCP gateway's clientId.",
          "default": "krateo-ide"
        },
        "name": {
          "type": "string",
          "title": "Display name",
          "description": "Shown on the consent and login pages.",
          "default": "Krateo IDE (MCP)"
        },
        "audience": {
          "type": "string",
          "title": "MCP audience",
          "description": "The MCP resource the gateway expects in the access token's aud, byte-for-byte, e.g. https://cmp.example.com/mcp (https, lowercase host, path /mcp, no trailing slash). Empty by default, meaning unset: the chart refuses to render when ideClient.enabled is true and this is empty, so it can never ship pointing at someone else's host.",
          "default": ""
        },
        "redirectUris": {
          "type": "array",
          "title": "Redirect URIs",
          "description": "Loopback redirects; the IDE opens the port (RFC 8252 7.3).",
          "items": {
            "type": "string"
          },
          "default": [
            "http://localhost:*",
            "http://127.0.0.1:*"
          ]
        },
        "groupsClaim": {
          "type": "string",
          "title": "Groups claim",
          "description": "Token claim carrying bare group names, as for the portal client.",
          "default": "groups"
        }
      }
    },
    "parentClient": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "rootUrl": {
          "type": "string"
        },
        "redirectUris": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "webOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postLogoutRedirectUris": {
          "type": "string"
        },
        "groupsClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deletionPolicy": {
      "description": "orphan (default): deleting this chart's resources leaves the Keycloak objects in place. delete: deletes them.",
      "type": "string",
      "enum": [
        "orphan",
        "delete"
      ]
    },
    "oidcConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "keycloakUrl": {
          "type": "string",
          "pattern": "^(https://.+)?$"
        },
        "discoveryUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalScopes": {
          "type": "string"
        },
        "graphics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "displayName": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "backgroundColor": {
              "type": "string"
            },
            "textColor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
