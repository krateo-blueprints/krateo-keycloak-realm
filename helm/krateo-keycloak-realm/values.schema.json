{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "krateo-keycloak-realm values",
  "type": "object",
  "properties": {
    "global": {
      "description": "Injected by Krateo's chart-inspector at install time.",
      "type": "object"
    },
    "resourceGroup": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "realm": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][-A-Za-z0-9_.]*$"
        },
        "displayName": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "registrationAllowed": {
          "type": "boolean"
        },
        "resetPasswordAllowed": {
          "type": "boolean"
        },
        "verifyEmail": {
          "type": "boolean"
        },
        "loginWithEmailAllowed": {
          "type": "boolean"
        },
        "actionTokenGeneratedByAdminLifespan": {
          "description": "Seconds an administrator-sent action link (the set-password email) stays valid.",
          "type": "integer",
          "minimum": 60
        },
        "events": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "listeners": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "string",
              "pattern": "^[0-9]{1,5}$"
            },
            "from": {
              "type": "string"
            },
            "fromDisplayName": {
              "type": "string"
            },
            "replyTo": {
              "type": "string"
            },
            "auth": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "starttls": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "ssl": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "credentialsSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "userKey": {
                  "type": "string",
                  "minLength": 1
                },
                "passwordKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecretKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "authType": {
              "type": "string",
              "enum": [
                "basic",
                "token"
              ]
            },
            "token": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "clientId": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "description": "Keycloak group attributes: each key maps to a list of strings.",
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "parentClient": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "rootUrl": {
          "type": "string"
        },
        "redirectUris": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "webOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postLogoutRedirectUris": {
          "type": "string"
        },
        "groupsClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deletionPolicy": {
      "description": "orphan (default): deleting this chart's resources leaves the Keycloak objects in place. delete: deletes them.",
      "type": "string",
      "enum": [
        "orphan",
        "delete"
      ]
    },
    "oidcConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "keycloakUrl": {
          "type": "string",
          "pattern": "^(https://.+)?$"
        },
        "discoveryUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalScopes": {
          "type": "string"
        },
        "graphics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "displayName": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "backgroundColor": {
              "type": "string"
            },
            "textColor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
